+/// Check a Linux catalog PID against this sandbox's inherited lifecycle identity.
+///
+/// A pidfd pins the observed process while evidence is read. A matching lock inode
+/// proves ownership; another program or another machine name proves reuse. Missing
+/// proof is an error, never permission to signal or clean up an uncertain runtime.
+/// This observer does not write metadata, signal a process, or reap a child.
+#[cfg(target_os = "linux")]
+pub fn recorded_runtime_is_alive(pid: i32, run_dir: &Path, name: &str) -> std::io::Result<bool> {
+    use std::os::fd::OwnedFd;
+    use std::os::unix::fs::MetadataExt;
+
+    if pid <= 0 {
+        return Ok(false);
+    }
+    let fd = unsafe { libc::syscall(libc::SYS_pidfd_open, pid, 0) };
+    if fd < 0 {
+        let error = std::io::Error::last_os_error();
+        if error.raw_os_error() == Some(libc::ESRCH) {
+            return Ok(false);
+        }
+        // Run PIDs are process leaders. Linux may recycle one as an unrelated
+        // thread ID; pidfd_open cannot pin that TID as a process leader.
+        if error.raw_os_error() == Some(libc::EINVAL) {
+            let status = std::fs::read_to_string(format!("/proc/{pid}/status"))?;
+            let group = status
+                .lines()
+                .find_map(|line| line.strip_prefix("Tgid:")?.trim().parse::<i32>().ok());
+            if group.is_some_and(|group| group != pid) {
+                return Ok(false);
+            }
+        }
+        return Err(error);
+    }
+    let process = unsafe { OwnedFd::from_raw_fd(fd as i32) };
+    let exited = || -> std::io::Result<bool> {
+        let mut poll = libc::pollfd {
+            fd: process.as_raw_fd(),
+            events: libc::POLLIN,
+            revents: 0,
+        };
+        if unsafe { libc::poll(&mut poll, 1, 0) } < 0 {
+            return Err(std::io::Error::last_os_error());
+        }
+        Ok(poll.revents & (libc::POLLIN | libc::POLLHUP) != 0)
+    };
+    if exited()? {
+        return Ok(false);
+    }
+    let inherited = format!("/proc/{pid}/fd/{}", crate::launch::LIFECYCLE_LOCK_FD);
+    match std::fs::metadata(inherited) {
+        Ok(actual) => match std::fs::metadata(lifecycle_lock_path(run_dir, name)) {
+            Ok(expected) if (actual.dev(), actual.ino()) == (expected.dev(), expected.ino()) => {
+                return Ok(!exited()?);
+            }
+            Ok(_) => {}
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Err(error) => return Err(error),
+        },
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+        Err(error) => return Err(error),
+    }
+    let executable = match std::fs::read_link(format!("/proc/{pid}/exe")) {
+        Ok(executable) => executable,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            // A zombie leader can leave workers finishing kernel teardown.
+            // Ordinary disk admission remains the resource-release barrier.
+            if exited()? || !microsandbox_utils::process::pid_is_alive(pid) {
+                return Ok(false);
+            }
+            return Err(error);
+        }
+        Err(error) => return Err(error),
+    };
+    if !matches!(
+        executable.file_name().and_then(|name| name.to_str()),
+        Some("msb" | "msb (deleted)")
+    ) {
+        return Ok(false);
+    }
+    let command = std::fs::read(format!("/proc/{pid}/cmdline"))?;
+    let args: Vec<_> = command.split(|byte| *byte == 0).collect();
+    let other_machine = args.get(1).copied() == Some(b"machine")
+        && args
+            .windows(2)
+            .find(|pair| pair[0] == b"--name")
+            .is_some_and(|pair| pair[1] != name.as_bytes());
+    if exited()? || other_machine {
+        return Ok(false);
+    }
+    Err(std::io::Error::other(format!(
+        "cannot verify runtime ownership for sandbox {name:?}, recorded pid {pid}"
+    )))
 }
 
