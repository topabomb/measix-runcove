+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn inspection_output_rejects_modified_bytes_even_with_matching_metadata() {
+        let directory = tempfile::tempdir().unwrap();
+        let path = directory.path().join("view.raw");
+        fs::write(&path, vec![1; 131072]).unwrap();
+        let output = CapturedLayer {
+            content_root: content_root(&io::exact(&path).unwrap()).unwrap(),
+            path,
+        };
+        verify_output(
+            &output,
+            &io::identity(&io::exact(&output.path).unwrap()).unwrap(),
+        )
+        .unwrap();
+
+        fs::write(&output.path, vec![2; 131072]).unwrap();
+        // Model a write in the same filesystem timestamp tick deterministically.
+        let unchanged_stamp = io::identity(&io::exact(&output.path).unwrap()).unwrap();
+        assert!(verify_output(&output, &unchanged_stamp).is_err());
+    }
+}
