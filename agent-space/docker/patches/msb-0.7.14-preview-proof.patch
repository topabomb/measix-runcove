+fn verify_output(output: &CapturedLayer, stamp: &io::Identity) -> Result<(), String> {
+    let file = io::exact(&output.path)?;
+    // A same-size write can leave both timestamps unchanged within one filesystem tick.
+    if io::identity(&file)? != *stamp || content_root(&file)? != output.content_root {
         return Err(
             "the disposable inspection image changed; inspect a fresh recovery session".into(),
         );
