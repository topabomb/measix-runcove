# Apply only to a verified 0.7.2 image whose service already uses SQLite 3.51.3.
# Preserve its application, entrypoint, static/dynamic user contract and helpers.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}
ARG BASE_IMAGE_ID
LABEL io.agent-space.sqlite="3.51.3" \
      io.agent-space.runtime-repair-base="${BASE_IMAGE_ID}" \
      io.agent-space.runtime-source="60d4dc8a436fb9365491567ec21d073e924e3c6d"
COPY msb /usr/local/bin/msb
COPY sqlite-check /usr/local/bin/agent-space-sqlite-check
COPY runtime.json /opt/agent-space/runtime.json
COPY msb.sha256 /opt/agent-space/msb.sha256
COPY runtime-repair-entrypoint.sh /usr/local/bin/agent-space-runtime-repair-entrypoint.sh
RUN chmod +x /usr/local/bin/msb /usr/local/bin/agent-space-sqlite-check && \
    chmod +x /usr/local/bin/agent-space-runtime-repair-entrypoint.sh && \
    ! ldd /usr/local/bin/msb | grep -q libsqlite3 && \
    /usr/local/bin/msb --version | grep -Fx 'msb 0.7.2' && \
    /usr/local/bin/agent-space-sqlite-check
ENTRYPOINT ["agent-space-runtime-repair-entrypoint.sh"]
