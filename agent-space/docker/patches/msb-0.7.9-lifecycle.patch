+#[cfg(all(test, target_os = "linux"))]
+mod recorded_runtime_tests {
+    use super::*;
+    struct Child(std::process::Child);
+    impl std::ops::Deref for Child {
+        type Target = std::process::Child;
+        fn deref(&self) -> &Self::Target {
+            &self.0
+        }
+    }
+    impl std::ops::DerefMut for Child {
+        fn deref_mut(&mut self) -> &mut Self::Target {
+            &mut self.0
+        }
+    }
+    impl Drop for Child {
+        fn drop(&mut self) {
+            let _ = self.0.kill();
+            let _ = self.0.wait();
+        }
+    }
+    use std::os::unix::process::CommandExt;
+    use std::process::{Command, Stdio};
+
+    #[test]
+    fn recycled_thread_id_is_not_a_recorded_process_owner() {
+        let home = tempfile::tempdir().unwrap();
+        std::thread::spawn(move || {
+            let tid = unsafe { libc::syscall(libc::SYS_gettid) } as i32;
+            assert_ne!(tid, std::process::id() as i32);
+            assert!(!recorded_runtime_is_alive(tid, home.path(), "thread-reuse").unwrap());
+        })
+        .join()
+        .unwrap();
+    }
+
+    #[test]
+    fn unrelated_process_survives_identity_observation() {
+        let home = tempfile::tempdir().unwrap();
+        let mut child = Child(Command::new("sleep").arg("30").spawn().unwrap());
+        assert!(!recorded_runtime_is_alive(child.id() as i32, home.path(), "recycled").unwrap());
+        assert!(child.try_wait().unwrap().is_none());
+        assert!(!recorded_runtime_is_alive(i32::MAX, home.path(), "missing").unwrap());
+    }
+
+    #[test]
+    fn matching_inherited_inode_proves_owner_even_after_binary_rename() {
+        let home = tempfile::tempdir().unwrap();
+        let guard = acquire_lifecycle_guard(home.path(), "owner").unwrap();
+        let fd = guard.as_raw_fd();
+        let mut command = Command::new("sleep");
+        command.arg("30").stdout(Stdio::null());
+        unsafe {
+            command.pre_exec(move || {
+                let copy = libc::fcntl(fd, libc::F_DUPFD_CLOEXEC, 200);
+                if copy < 0 {
+                    return Err(std::io::Error::last_os_error());
+                }
+                let result = libc::dup2(copy, crate::launch::LIFECYCLE_LOCK_FD);
+                libc::close(copy);
+                if result < 0 {
+                    return Err(std::io::Error::last_os_error());
+                }
+                Ok(())
+            });
+        }
+        let child = Child(command.spawn().unwrap());
+        assert!(recorded_runtime_is_alive(child.id() as i32, home.path(), "owner").unwrap());
+        assert!(!recorded_runtime_is_alive(child.id() as i32, home.path(), "other").unwrap());
+    }
+
